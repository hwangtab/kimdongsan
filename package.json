{
  "name": "kimdongsan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "assets:audio": "./scripts/prepare-audio.sh",
    "assets:images": "./scripts/prepare-images.sh",
    "assets:waveforms": "python3 scripts/waveforms.py",
    "assets:og": "uv run --with pillow python scripts/prepare-og.py",
    "assets:font": "uv run --with fonttools --with brotli python scripts/subset-font.py",
    "assets:miwon": "uv run --with pillow python scripts/miwon-titles.py",
    "assets:pixel-font": "uv run --with fonttools --with brotli python scripts/subset-pixel-font.py",
    "assets:brand": "uv run --with fonttools --with brotli --with pillow python scripts/brand-titles.py"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
